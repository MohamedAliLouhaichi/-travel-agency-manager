datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SECRETARY
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BookingType {
  HOTEL
  FLIGHT
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER
}

enum ImportStatus {
  PENDING
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
}

enum ImportType {
  CUSTOMER
  HOTEL_BOOKING
  FLIGHT_BOOKING
  PAYMENT
}

model User {
  id            String        @id @default(uuid())
  fullName      String        @map("full_name")
  email         String        @unique
  passwordHash  String        @map("password_hash")
  role          UserRole      @default(SECRETARY)
  status        UserStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  bookings      Booking[]     @relation("ResponsibleEmployee")
  payments      Payment[]
  invoices      Invoice[]     @relation("GeneratedBy")
  importBatches ImportBatch[] @relation("UploadedBy")
  activityLogs  ActivityLog[]

  @@map("users")
}

model Customer {
  id             String    @id @default(uuid())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String
  email          String
  address        String?
  nationality    String?
  passportNumber String?   @map("passport_number")
  passportExpiry DateTime? @map("passport_expiry_date")
  dateOfBirth    DateTime? @map("date_of_birth")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  bookings       Booking[]
  invoices       Invoice[]

  @@map("customers")
}

model Booking {
  id              String         @id @default(uuid())
  customerId      String         @map("customer_id")
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employeeId      String         @map("employee_id")
  employee        User           @relation("ResponsibleEmployee", fields: [employeeId], references: [id])
  bookingType     BookingType    @map("booking_type")
  destination     String
  startDate       DateTime       @map("start_date")
  endDate         DateTime       @map("end_date")
  totalPrice      Decimal        @map("total_price") @db.Decimal(12, 3)
  paidAmount      Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 3)
  remainingAmount Decimal        @map("remaining_amount") @db.Decimal(12, 3)
  bookingStatus   BookingStatus  @default(DRAFT) @map("booking_status")
  paymentStatus   PaymentStatus  @default(UNPAID) @map("payment_status")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  hotelBooking    HotelBooking?
  flightBooking   FlightBooking?
  payments        Payment[]
  invoices        Invoice[]

  @@map("bookings")
}

model HotelBooking {
  id                 String   @id @default(uuid())
  bookingId          String   @unique @map("booking_id")
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelName          String   @map("hotel_name")
  city               String
  country            String
  checkInDate        DateTime @map("check_in_date")
  checkOutDate       DateTime @map("check_out_date")
  numberOfNights     Int      @map("number_of_nights")
  roomType           String   @map("room_type")
  numberOfRooms      Int      @default(1) @map("number_of_rooms")
  numberOfGuests     Int      @default(1) @map("number_of_guests")
  boardType          String   @map("board_type")
  confirmationNumber String?  @map("confirmation_number")

  @@map("hotel_bookings")
}

model FlightBooking {
  id                   String   @id @default(uuid())
  bookingId            String   @unique @map("booking_id")
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  airline              String
  flightNumber         String   @map("flight_number")
  departureAirport     String   @map("departure_airport")
  arrivalAirport       String   @map("arrival_airport")
  departureCity        String   @map("departure_city")
  arrivalCity          String   @map("arrival_city")
  departureDatetime    DateTime @map("departure_datetime")
  arrivalDatetime      DateTime @map("arrival_datetime")
  ticketNumber         String?  @map("ticket_number")
  reservationReference String?  @map("reservation_reference")
  passengerCount       Int      @default(1) @map("passenger_count")

  @@map("flight_bookings")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUserId String        @map("created_by_id")
  createdByUser   User          @relation(fields: [createdByUserId], references: [id])
  amount          Decimal       @db.Decimal(12, 3)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentDate     DateTime      @default(now()) @map("payment_date")
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique @map("invoice_number")
  bookingId       String   @map("booking_id")
  booking         Booking  @relation(fields: [bookingId], references: [id])
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id])
  generatedById   String   @map("generated_by_id")
  generatedByUser User     @relation("GeneratedBy", fields: [generatedById], references: [id])
  issueDate       DateTime @default(now()) @map("issue_date")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 3)
  paidAmount      Decimal  @map("paid_amount") @db.Decimal(12, 3)
  remainingAmount Decimal  @map("remaining_amount") @db.Decimal(12, 3)
  pdfPath         String   @map("pdf_path")

  @@map("invoices")
}

model ImportBatch {
  id           String        @id @default(uuid())
  fileName     String        @map("file_name")
  fileType     String        @map("file_type")
  importType   ImportType    @map("import_type")
  status       ImportStatus  @default(PENDING)
  totalRows    Int           @default(0) @map("total_rows")
  successRows  Int           @default(0) @map("success_rows")
  failedRows   Int           @default(0) @map("failed_rows")
  uploadedById String        @map("uploaded_by_id")
  uploadedBy   User          @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  errors       ImportError[]

  @@map("import_batches")
}

model ImportError {
  id            String      @id @default(uuid())
  importBatchId String      @map("import_batch_id")
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber     Int         @map("row_number")
  fieldName     String?     @map("field_name")
  errorMessage  String      @map("error_message")
  rawData       String?     @map("raw_data") @db.Text

  @@map("import_errors")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}
